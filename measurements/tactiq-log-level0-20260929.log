# tactiq_log hardware pass, Rock 5A, slot B. Console output as captured.

root@tactiq-rock5a:~# cat /etc/tactiq-release
TACTIQ_OS_VERSION=2.1.0
TACTIQ_OS_CODENAME=hardened-edge
TACTIQ_BUILD_MACHINE=tactiq-rock5a
TACTIQ_META_TACTIQ_GIT=v2.1.0-rc12
TACTIQ_IMAGE_NAME=tactiq-image-dev
TACTIQ_RELEASE_DATE=2026-09-24

# state block (cmdline, getenforce, /dev/mapper)
SELINUX Enforcing
IMA     OFF
ROOT    root=PARTLABEL=rootfs_b
DM      NONE
SLOT    B

