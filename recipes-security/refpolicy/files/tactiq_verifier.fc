# Configuration
/etc/tactiq/verifier(/.*)?		gen_context(system_u:object_r:tactiq_verifier_conf_t,s0)
# Certificates (CA cert, server cert, client CAs)
/etc/tactiq/verifier/certs(/.*)?	gen_context(system_u:object_r:tactiq_verifier_cert_t,s0)

# Verifier binary
/opt/tactiq/bin/tactiq-verifier		--	gen_context(system_u:object_r:tactiq_verifier_exec_t,s0)

# CRL publish directory
/var/lib/tactiq/verifier/crl(/.*)?	gen_context(system_u:object_r:tactiq_verifier_crl_t,s0)
# Runtime state
/var/lib/tactiq/verifier(/.*)?		gen_context(system_u:object_r:tactiq_verifier_var_t,s0)

# Logs
/var/log/tactiq/verifier(/.*)?		gen_context(system_u:object_r:tactiq_verifier_log_t,s0)
