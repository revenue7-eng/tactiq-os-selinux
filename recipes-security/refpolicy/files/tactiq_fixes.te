policy_module(tactiq_fixes, 2.4.0)

########################################
# Fix: busybox klogd/syslogd need read+map on bin_t
########################################
gen_require(`
    type klogd_t;
    type syslogd_t;
    type bin_t;
')
allow klogd_t bin_t:file { read map execute open getattr };
allow syslogd_t bin_t:file { read map execute open getattr };
allow klogd_t syslogd_runtime_t:sock_file write;
allow syslogd_t syslogd_runtime_t:sock_file write;

########################################
# Fix: systemd-tmpfiles needs access to /data
########################################
gen_require(`
    type systemd_tmpfiles_t;
    type tactiq_vault_data_t;
')
allow systemd_tmpfiles_t tactiq_vault_data_t:dir { getattr search };

########################################
# Fix: mount needs mounton for /var/spool
########################################
gen_require(`
    type mount_t;
    type var_spool_t;
')
allow mount_t var_spool_t:dir mounton;

########################################
# Fix: ssh-keygen needs write to /var/volatile/ssh
########################################
gen_require(`
    type ssh_keygen_t;
    type initrc_runtime_t;
')
allow ssh_keygen_t initrc_runtime_t:dir { search write add_name };
allow ssh_keygen_t initrc_runtime_t:file { create write open getattr };

########################################
# Fix: services need syslog socket (dev-log)
########################################
gen_require(`
    type system_dbusd_t;
    type chronyd_t;
    type local_login_t;
    type getty_t;
    type syslogd_runtime_t;
')
allow system_dbusd_t syslogd_runtime_t:sock_file write;
allow chronyd_t syslogd_runtime_t:sock_file write;
allow local_login_t syslogd_runtime_t:sock_file write;
allow getty_t syslogd_runtime_t:sock_file write;

########################################
# Fix: init_t (systemd) needs access to /data and TPM relabel
########################################
gen_require(`
    type init_t;
    type tactiq_vault_data_t;
    type tactiq_tpm_device_t;
    type unlabeled_t;
')
allow init_t tactiq_vault_data_t:dir { getattr search read open };
allow init_t tactiq_vault_data_t:file { getattr read open };
# SUPERSEDED by dev_node(tactiq_tpm_device_t) in tactiq_tpm.te (v2.0.1).
# Kept until an enforcing boot on a board with a physical TPM shows
# /dev/tpm0 present and labeled tactiq_tpm_device_t with no related
# denials. "Zero denials" alone is not evidence: with no TPM fitted the
# device node never appears and nothing touches the path.
# Then delete (Tier 2 cleanup, see CHANGES-selinux-hardening.md).
allow init_t tactiq_tpm_device_t:chr_file relabelto;

# restorecon /data: init_t (oneshot vault-relabel) метит пустой раздел в vault-тип
allow init_t unlabeled_t:dir { relabelfrom getattr search read open };
allow init_t unlabeled_t:file { relabelfrom getattr read open };
allow init_t tactiq_vault_data_t:dir { relabelto getattr search read open };
allow init_t tactiq_vault_data_t:file { relabelto getattr read open };

# restorecon /data РЕАЛЬНО бежит в initrc_t (ExecStart=/bin/sh), не init_t.
# Артефакт: _dbg.log id → context=initrc_t, restorecon_rc=255 без этих правил.
gen_require(`
    type initrc_t;
    type unlabeled_t;
    type tactiq_vault_data_t;
')
allow initrc_t unlabeled_t:dir { relabelfrom getattr search read open };
allow initrc_t unlabeled_t:file { relabelfrom getattr read open };
allow initrc_t tactiq_vault_data_t:dir { relabelto getattr search read open };
allow initrc_t tactiq_vault_data_t:file { relabelto getattr read open };

# Label separation: restorecon moves keys/counter/audit out of the vault type
# into the state and audit types, so the source of the relabel is the vault
# type, not unlabeled_t. Both domains are covered because which one runs the
# relabel is decided by the unit, not by this policy.
require { type tactiq_agent_state_t; type tactiq_agent_audit_t; }
allow initrc_t tactiq_vault_data_t:dir relabelfrom;
allow initrc_t tactiq_vault_data_t:file relabelfrom;
allow initrc_t tactiq_agent_state_t:dir { relabelto getattr search read open };
allow initrc_t tactiq_agent_state_t:file { relabelto getattr read open };
allow initrc_t tactiq_agent_audit_t:dir { relabelto getattr search read open };
allow initrc_t tactiq_agent_audit_t:file { relabelto getattr read open };
allow init_t tactiq_vault_data_t:dir relabelfrom;
allow init_t tactiq_vault_data_t:file relabelfrom;
allow init_t tactiq_agent_state_t:dir { relabelto getattr search read open };
allow init_t tactiq_agent_state_t:file { relabelto getattr read open };
allow init_t tactiq_agent_audit_t:dir { relabelto getattr search read open };
allow init_t tactiq_agent_audit_t:file { relabelto getattr read open };

########################################
# Fix: TPM device file association on devtmpfs
########################################
gen_require(`
    type tactiq_tpm_device_t;
    type device_t;
')
allow tactiq_tpm_device_t device_t:filesystem associate;

########################################
# Fix: udev needs full access for TPM device management
########################################
gen_require(`
    type udev_t;
    type tactiq_tpm_device_t;
')
allow udev_t tactiq_tpm_device_t:chr_file { getattr relabelfrom relabelto write };

########################################
# Fix: unconfined admin access to /data/tactiq
########################################
gen_require(`
    type unconfined_t;
    type unconfined_mount_t;
    type tactiq_vault_data_t;
')
allow unconfined_t tactiq_vault_data_t:dir { getattr search read write open add_name remove_name create };
allow unconfined_t tactiq_vault_data_t:file { getattr read write open create unlink };
allow unconfined_mount_t tactiq_vault_data_t:dir { search mounton };

# --- /data partition mount (via /run/tactiq-data) ---
allow mount_t initrc_runtime_t:dir mounton;


# --- Allow mount on /data (tactiq_vault_data_t) ---
allow mount_t tactiq_vault_data_t:dir mounton;


########################################
# Hardening invariants (neverallow assertions)
#
# These grant nothing. They are assertions checked when the policy is built:
# if a future edit (here or upstream) ever introduces an allow that violates
# one, the policy build FAILS LOUD rather than shipping a weakened production
# policy. Every listed domain already satisfies them, so this is a runtime
# no-op today.
#
# Types referenced are only those actually built per TACTIQ_MODULES in
# refpolicy-targeted_%.bbappend. The upstream-style rauc_t is NOT built
# (only tactiq_rauc_t ships), so it must not be referenced here.
########################################
gen_require(`
    type tactiq_agent_t;
    type tactiq_tpm_t;
    type tactiq_vault_t;
    type tactiq_tamper_t;
    type tactiq_rauc_t;
')
# 1. W^X for the attestation-integrity domains. The agent (ECDSA P-256 inside
#    the TPM), the TPM helper, and the vault must never map writable+executable
#    memory -- no JIT, no injected code in a domain that touches keys or the
#    attestation quote. The requirement is on the domain, not on what its
#    runtime happens to need: an attestation domain must have no W^X primitive
#    even if a future runtime would tolerate one. The agent is Rust with no JIT
#    today.
neverallow { tactiq_agent_t tactiq_tpm_t tactiq_vault_t } self:process { execmem execstack execheap };

# 2. No kernel-module loading from any TactiQ domain. Prevents a confined
#    domain from becoming a module-load primitive (a classic MAC-escape path).
neverallow { tactiq_agent_t tactiq_tpm_t tactiq_vault_t tactiq_tamper_t tactiq_rauc_t } self:capability sys_module;

# NOTE: a third assertion forbidding tactiq_rauc_t from executing bin_t was
# considered and deliberately NOT added. RAUC bundle-hook execution is an
# active, upstream-coordinated design area (see
# measurements/selinux-rauc-hook-exec-20260806.md and the bundle-mount-context
# discussion): the updater's execute surface is intentionally being opened
# (tactiq_squashfs_t + shell_exec_t today). Welding bin_t execution shut now
# would pre-constrain that design. Revisit once hook-exec settles upstream.

########################################
# Agent tool boundary
#
# A tool is reached only through agentgateway. Tools are local stdio
# processes that agentgateway starts (agentgateway-config: no host: target),
# so a tool has no port and no socket of its own. agentgateway_t is the only
# TactiQ domain that may execute a tool binary or enter a tool domain
# (assertions 3 and 4), and an AI agent's domain reaches nothing over the
# network but the gateway's port: not tactiq-stop, not an address on the
# plant network (5 and 6).
#
# Three attributes carry the boundary, so a new tool or agent module joins it
# by adding its types, and these assertions then hold for it with no edit
# here:
#   tactiq_tool_domain     the domain a tool runs in
#   tactiq_tool_exec       a tool's executable
#   tactiq_ai_agent_domain the domain an AI agent runs in (not
#                          tactiq_agent_t, which is the attestation prover)
# Like the block above, this grants nothing.
#
# unconfined_t is deliberately not listed: the targeted policy grants it
# broad execute and connect, so listing it would fail the build rather than
# assert anything. Whether a production image offers any entry into an
# unconfined domain is a separate question and is not settled here.
########################################
attribute tactiq_tool_domain;
attribute tactiq_tool_exec;
attribute tactiq_ai_agent_domain;

gen_require(`
    type tactiq_verifier_t;
    type tactiq_ctl_t;
    type tactiq_edge_daemon_t;
    type tactiq_logsetup_t;
    type tactiq_netperm_t;
    type tactiq_stop_t;
    type agentgateway_port_t;
    attribute port_type;
')

# 3. No TactiQ domain other than agentgateway_t executes a tool binary.
neverallow { tactiq_ai_agent_domain tactiq_agent_t tactiq_tpm_t tactiq_verifier_t tactiq_tamper_t tactiq_vault_t tactiq_ctl_t tactiq_rauc_t tactiq_edge_daemon_t tactiq_logsetup_t tactiq_netperm_t tactiq_stop_t } tactiq_tool_exec:file { execute execute_no_trans entrypoint };

# 4. No TactiQ domain other than agentgateway_t enters a tool domain.
neverallow { tactiq_ai_agent_domain tactiq_agent_t tactiq_tpm_t tactiq_verifier_t tactiq_tamper_t tactiq_vault_t tactiq_ctl_t tactiq_rauc_t tactiq_edge_daemon_t tactiq_logsetup_t tactiq_netperm_t tactiq_stop_t } tactiq_tool_domain:process { transition dyntransition };

# 5. An AI agent connects over TCP to agentgateway's port and to nothing
#    else: not tactiq-stop, not an address on the plant network.
neverallow tactiq_ai_agent_domain { port_type -agentgateway_port_t }:tcp_socket name_connect;

# 6. An AI agent opens no datagram, raw, packet, SCTP or ICMP socket. A port
#    type does not bound those, so they are closed by the socket class.
neverallow tactiq_ai_agent_domain self:{ udp_socket rawip_socket packet_socket sctp_socket icmp_socket } create;
