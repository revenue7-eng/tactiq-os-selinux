policy_module(tactiq_fixes, 2.0.8)

########################################
# Fix: busybox klogd/syslogd need read+map on bin_t
########################################
gen_require(`
    type klogd_t;
    type syslogd_t;
    type bin_t;
')
allow klogd_t bin_t:file { read map execute open getattr };
allow syslogd_t bin_t:file { read map execute open getattr };
allow klogd_t syslogd_runtime_t:sock_file write;
allow syslogd_t syslogd_runtime_t:sock_file write;

########################################
# Fix: systemd-tmpfiles needs access to /data
########################################
gen_require(`
    type systemd_tmpfiles_t;
    type tactiq_vault_data_t;
')
allow systemd_tmpfiles_t tactiq_vault_data_t:dir { getattr search };

########################################
# Fix: mount needs mounton for /var/spool
########################################
gen_require(`
    type mount_t;
    type var_spool_t;
')
allow mount_t var_spool_t:dir mounton;

########################################
# Fix: ssh-keygen needs write to /var/volatile/ssh
########################################
gen_require(`
    type ssh_keygen_t;
    type initrc_runtime_t;
')
allow ssh_keygen_t initrc_runtime_t:dir { search write add_name };
allow ssh_keygen_t initrc_runtime_t:file { create write open getattr };

########################################
# Fix: services need syslog socket (dev-log)
########################################
gen_require(`
    type system_dbusd_t;
    type chronyd_t;
    type local_login_t;
    type getty_t;
    type syslogd_runtime_t;
')
allow system_dbusd_t syslogd_runtime_t:sock_file write;
allow chronyd_t syslogd_runtime_t:sock_file write;
allow local_login_t syslogd_runtime_t:sock_file write;
allow getty_t syslogd_runtime_t:sock_file write;

########################################
# Fix: init_t (systemd) needs access to /data and TPM relabel
########################################
gen_require(`
    type init_t;
    type tactiq_vault_data_t;
    type tactiq_tpm_device_t;
    type unlabeled_t;
')
allow init_t tactiq_vault_data_t:dir { getattr search read open };
allow init_t tactiq_vault_data_t:file { getattr read open };
allow init_t tactiq_tpm_device_t:chr_file relabelto;

# restorecon /data: init_t (oneshot vault-relabel) метит пустой раздел в vault-тип
allow init_t unlabeled_t:dir { relabelfrom getattr search read open };
allow init_t unlabeled_t:file { relabelfrom getattr read open };
allow init_t tactiq_vault_data_t:dir { relabelto getattr search read open };
allow init_t tactiq_vault_data_t:file { relabelto getattr read open };

# restorecon /data РЕАЛЬНО бежит в initrc_t (ExecStart=/bin/sh), не init_t.
# Артефакт: _dbg.log id → context=initrc_t, restorecon_rc=255 без этих правил.
gen_require(`
    type initrc_t;
    type unlabeled_t;
    type tactiq_vault_data_t;
')
allow initrc_t unlabeled_t:dir { relabelfrom getattr search read open };
allow initrc_t unlabeled_t:file { relabelfrom getattr read open };
allow initrc_t tactiq_vault_data_t:dir { relabelto getattr search read open };
allow initrc_t tactiq_vault_data_t:file { relabelto getattr read open };

########################################
# Fix: TPM device file association on devtmpfs
########################################
gen_require(`
    type tactiq_tpm_device_t;
    type device_t;
')
allow tactiq_tpm_device_t device_t:filesystem associate;

########################################
# Fix: udev needs full access for TPM device management
########################################
gen_require(`
    type udev_t;
    type tactiq_tpm_device_t;
')
allow udev_t tactiq_tpm_device_t:chr_file { getattr relabelfrom relabelto write };

########################################
# Fix: unconfined admin access to /data/tactiq
########################################
gen_require(`
    type unconfined_t;
    type unconfined_mount_t;
    type tactiq_vault_data_t;
')
allow unconfined_t tactiq_vault_data_t:dir { getattr search read write open add_name remove_name create };
allow unconfined_t tactiq_vault_data_t:file { getattr read write open create unlink };
allow unconfined_mount_t tactiq_vault_data_t:dir { search mounton };

# --- /data partition mount (via /run/tactiq-data) ---
allow mount_t initrc_runtime_t:dir mounton;


# --- Allow mount on /data (tactiq_vault_data_t) ---
allow mount_t tactiq_vault_data_t:dir mounton;
