policy_module(tactiq_rauc, 2.10.0)

########################################
#
# Declarations
#

type tactiq_boot_content_t;
files_type(tactiq_boot_content_t)

type tactiq_rauc_t;
type tactiq_rauc_exec_t;
init_daemon_domain(tactiq_rauc_t, tactiq_rauc_exec_t)

type tactiq_rauc_bundle_t;
files_type(tactiq_rauc_bundle_t)

type tactiq_rauc_conf_t;
files_config_file(tactiq_rauc_conf_t)

type tactiq_rauc_log_t;
logging_log_file(tactiq_rauc_log_t)

type tactiq_rauc_runtime_t;
files_type(tactiq_rauc_runtime_t)

type tactiq_rauc_status_t;
files_type(tactiq_rauc_status_t)

type tactiq_rauc_var_t;
files_type(tactiq_rauc_var_t)

type tactiq_ubootenv_exec_t;
application_executable_file(tactiq_ubootenv_exec_t)

# Runtime directory holding the generated fw_env.config. Own namespace:
# /run/tactiq belongs to the edge daemon, and a config the updater must
# read does not belong inside another component's runtime directory.
type tactiq_ubootenv_runtime_t;
files_runtime_file(tactiq_ubootenv_runtime_t)

########################################
#
# Local policy — tactiq_rauc_t
#

# --- Self rules ---
allow tactiq_rauc_t self:capability { fowner fsetid mknod sys_admin sys_rawio };
allow tactiq_rauc_t self:process { signal_perms setrlimit };
allow tactiq_rauc_t self:fifo_file rw_fifo_file_perms;
allow tactiq_rauc_t self:unix_stream_socket create_stream_socket_perms;

# --- Rules on owned objects, sorted by type ---

# tactiq_boot_content_t
allow tactiq_rauc_t tactiq_boot_content_t:dir list_dir_perms;
allow tactiq_rauc_t tactiq_boot_content_t:file read_file_perms;

# tactiq_rauc_bundle_t
allow tactiq_rauc_t tactiq_rauc_bundle_t:dir list_dir_perms;
allow tactiq_rauc_t tactiq_rauc_bundle_t:file read_file_perms;
# udev probes the loop device backing the bundle during install and
# hits the bundle label; harmless - silence it.
#
# Access stays denied here; only the audit record is suppressed.
# Upstream refpolicy made the opposite call for its own type: commit
# 9417c19a1 added rauc_getattr_bundle_files(udev_t) at udev.te:374,
# which expands to allow $1 rauc_bundle_t:file getattr_file_perms
# (rauc.if:53-59). There is no overlap today: that rule names
# rauc_bundle_t, this one names tactiq_rauc_bundle_t. If this module
# ever moves onto the upstream type, the stated property inverts from
# denied to allowed, and the width changes too: getattr_file_perms is
# a set, this rule covers getattr only. Re-decide at that point
# instead of carrying this wording over.
dontaudit udev_t tactiq_rauc_bundle_t:file getattr;

# tactiq_rauc_conf_t
allow tactiq_rauc_t tactiq_rauc_conf_t:dir list_dir_perms;
allow tactiq_rauc_t tactiq_rauc_conf_t:file read_file_perms;

# tactiq_rauc_log_t
allow tactiq_rauc_t tactiq_rauc_log_t:dir { search add_name };
allow tactiq_rauc_t tactiq_rauc_log_t:file { create open append getattr };
logging_log_filetrans(tactiq_rauc_t, tactiq_rauc_log_t, file)

# tactiq_rauc_runtime_t
manage_dirs_pattern(tactiq_rauc_t, tactiq_rauc_runtime_t, tactiq_rauc_runtime_t)
manage_files_pattern(tactiq_rauc_t, tactiq_rauc_runtime_t, tactiq_rauc_runtime_t)
manage_lnk_files_pattern(tactiq_rauc_t, tactiq_rauc_runtime_t, tactiq_rauc_runtime_t)
allow tactiq_rauc_t tactiq_rauc_runtime_t:dir mounton;

# tactiq_rauc_status_t — slot.raucs on target rootfs
# RAUC writes slot.raucs via atomic temp+rename in the root of the
# target partition (type root_t). type_transition narrows the grant:
# only files created by tactiq_rauc_t in root_t dirs receive
# tactiq_rauc_status_t; no other domain is affected.
allow tactiq_rauc_t tactiq_rauc_status_t:file manage_file_perms;

# tactiq_rauc_var_t
allow tactiq_rauc_t tactiq_rauc_var_t:dir manage_dir_perms;
allow tactiq_rauc_t tactiq_rauc_var_t:file manage_file_perms;
files_var_lib_filetrans(tactiq_rauc_t, tactiq_rauc_var_t, { dir file })

# tactiq_ubootenv_exec_t — fw_setenv/fw_printenv
# Runs in tactiq_rauc_t, no domain transition.
can_exec(tactiq_rauc_t, tactiq_ubootenv_exec_t)
allow tactiq_rauc_t tactiq_ubootenv_exec_t:lnk_file read_lnk_file_perms;

# tactiq_ubootenv_runtime_t — /run/tactiq-ubootenv/fw_env.config
allow tactiq_rauc_t tactiq_ubootenv_runtime_t:dir search_dir_perms;
allow tactiq_rauc_t tactiq_ubootenv_runtime_t:file read_file_perms;

# --- Rules on objects from other modules, sorted alphabetically ---

gen_require(`
    type fs_t;
    type init_t;
    type kernel_t;
    type loop_control_device_t;
    type root_t;
    type tactiq_squashfs_t;
    type tactiq_vault_data_t;
    type tmpfs_t;
    type udev_t;
    type var_lock_t;
    type var_run_t;
')

# fs_t
allow tactiq_rauc_t fs_t:filesystem { getattr mount remount unmount };

# kernel_t
dontaudit tactiq_rauc_t kernel_t:process setsched;

# loop_control_device_t — loop allocation for bundle mount
allow tactiq_rauc_t loop_control_device_t:chr_file rw_chr_file_perms;

# root_t — slot.raucs type_transition and transitional access
# init_t creates the runtime dir (RuntimeDirectory=) and writes the config
# there; tactiq-fw-env-setup has no exec type, so it runs as init_t.
allow init_t tactiq_ubootenv_runtime_t:dir manage_dir_perms;
allow init_t tactiq_ubootenv_runtime_t:file manage_file_perms;

type_transition tactiq_rauc_t root_t:file tactiq_rauc_status_t;
allow tactiq_rauc_t root_t:dir { search write add_name remove_name };
# Transitional: existing slot.raucs retains root_t until the first
# install under this policy re-creates it as tactiq_rauc_status_t.
allow tactiq_rauc_t root_t:file { read open getattr setattr rename unlink };

# tactiq_squashfs_t — mounted verity bundle (squashfs)
allow tactiq_rauc_t tactiq_squashfs_t:filesystem { getattr mount unmount };
allow tactiq_rauc_t tactiq_squashfs_t:dir list_dir_perms;
allow tactiq_rauc_t tactiq_squashfs_t:file read_file_perms;

# tactiq_vault_data_t — bundle source on /data (air-gapped path)
allow tactiq_rauc_t tactiq_vault_data_t:dir search;
allow tactiq_rauc_t tactiq_vault_data_t:file { read open getattr lock };
allow tactiq_rauc_t tactiq_vault_data_t:filesystem getattr;
dontaudit udev_t tactiq_vault_data_t:file getattr;

# var_lock_t — fw_printenv/fw_setenv lock file
allow tactiq_rauc_t var_lock_t:lnk_file read_lnk_file_perms;
allow tactiq_rauc_t var_lock_t:dir rw_dir_perms;
allow tactiq_rauc_t var_lock_t:file manage_file_perms;

# var_run_t — runtime mount tree /run/rauc
filetrans_pattern(tactiq_rauc_t, var_run_t, tactiq_rauc_runtime_t, { dir file lnk_file })
allow tactiq_rauc_t var_run_t:dir { getattr search };

# --- Calls to other modules, sorted alphabetically ---

corenet_tcp_connect_http_cache_port(tactiq_rauc_t)
corenet_tcp_connect_http_port(tactiq_rauc_t)
dev_read_sysfs(tactiq_rauc_t)
dev_read_urand(tactiq_rauc_t)
dev_rw_lvm_control(tactiq_rauc_t)
files_read_etc_files(tactiq_rauc_t)
files_read_etc_runtime_files(tactiq_rauc_t)
files_tmp_filetrans(tactiq_rauc_t, tactiq_rauc_var_t, { dir file })
fs_getattr_tmpfs(tactiq_rauc_t)
kernel_list_unlabeled(tactiq_rauc_t)
kernel_read_kernel_sysctls(tactiq_rauc_t)
kernel_read_system_state(tactiq_rauc_t)
logging_send_syslog_msg(tactiq_rauc_t)
miscfiles_read_generic_certs(tactiq_rauc_t)
miscfiles_read_localization(tactiq_rauc_t)
mount_exec(tactiq_rauc_t)
mount_list_runtime(tactiq_rauc_t)
storage_raw_read_fixed_disk(tactiq_rauc_t)
storage_raw_read_removable_device(tactiq_rauc_t)
storage_raw_write_fixed_disk(tactiq_rauc_t)
storage_raw_write_removable_device(tactiq_rauc_t)
sysnet_dns_name_resolve(tactiq_rauc_t)

# --- Blocks, sorted: optional_policy by module name ---

optional_policy(`
    gen_require(`
        type system_dbusd_t;
        class dbus { acquire_svc send_msg };
    ')

    allow tactiq_rauc_t self:dbus send_msg;

    dbus_system_bus_client(tactiq_rauc_t)
    dbus_connect_system_bus(tactiq_rauc_t)

    allow tactiq_rauc_t system_dbusd_t:dbus acquire_svc;
')

optional_policy(`
    gen_require(`
        type unconfined_t;
        class dbus send_msg;
    ')
    allow tactiq_rauc_t unconfined_t:dbus send_msg;
    allow unconfined_t tactiq_rauc_t:dbus send_msg;
')
