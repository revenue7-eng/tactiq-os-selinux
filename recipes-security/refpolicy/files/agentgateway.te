policy_module(agentgateway, 1.4.0)

########################################
# Type declarations
########################################
type agentgateway_t;
type agentgateway_exec_t;
type agentgateway_conf_t;
files_config_file(agentgateway_conf_t)
type agentgateway_log_t;
logging_log_file(agentgateway_log_t)

# Transition: systemd starts binary -> runs as agentgateway_t
init_daemon_domain(agentgateway_t, agentgateway_exec_t)

# agentgateway_port_t is NOT declared here. Operators that bind a port
# number to a type (portcon) are only accepted in the base policy, not in
# a loadable module -- confirmed with checkmodule 3.5-1, which rejects
# portcon at the parser. The type and its number are therefore declared by
# network_port() in kernel/corenetwork.te.in, patched in this layer, which
# also generates the corenet_*_agentgateway_port() interfaces used below.
#
# The listener uses TCP 49317. The number is fixed and documented because
# three layers depend on it (this policy, the systemd unit, the firewall
# rule). 49317 sits in the IANA dynamic range and does not collide with
# anything already declared in corenetwork.te.in -- note that the earlier
# choice of 49190 fell inside the virt_migration range (49152-49216) and
# would have been bound to virt_migration_port_t, denying the bind.

########################################
# Permissions
########################################

# --- Self ---
allow agentgateway_t self:process { signal_perms setrlimit getsched };
allow agentgateway_t self:fifo_file rw_fifo_file_perms;
allow agentgateway_t self:unix_stream_socket create_stream_socket_perms;
# create_stream_socket_perms already covers create+bind+listen+accept and,
# via rw_socket_perms, the socket-level connect permission. Egress is not
# closed here: it is closed by the absence of name_connect on any port type
# (see the block below).
allow agentgateway_t self:tcp_socket create_stream_socket_perms;

# --- Network: LISTEN on 49317 only ---
corenet_tcp_bind_agentgateway_port(agentgateway_t)
corenet_tcp_bind_generic_node(agentgateway_t)
#
# --- Management listeners: admin 15000, stats 15020, readiness 15021 ---
# agentgateway opens all three whatever the config says (it only chooses
# their addresses; TactiQ OS binds them to 127.0.0.1). Without a grant the
# gateway cannot start in this domain. Their own port type, from patch 0005,
# keeps this to the three numbers rather than unreserved_port_t.
corenet_tcp_bind_agentgateway_mgmt_port(agentgateway_t)
#
# --- Network: ask tactiq-stop before every tool call (extAuthz) ---
# The single outbound connection the gateway is allowed: to the stop
# service's port type, 49318. SELinux binds name_connect to the port type,
# not to an address; the unit's IPAddressAllow=localhost keeps it on
# loopback. Without this rule the extAuthz call fails, and with
# failureMode: deny every tool call is refused.
tactiq_stop_tcp_connect(agentgateway_t)
#
# Deliberately ABSENT (egress denied by default-deny):
#   corenet_tcp_connect_generic_port  -- no outbound connect
#   sysnet_dns_name_resolve           -- no DNS
#   http_port_t name_connect          -- no http backends
# v1 perimeter is empty (backends: []). stdio backends, when added,
# will require domain_auto_transition on the MCP subprocess exec --
# added at that time, not pre-provisioned here.

# --- Configuration (read-only) ---
# The config lives in /etc/tactiq/agentgateway; /etc/tactiq itself is
# tactiq_agent_conf_t. Without search on it the gateway cannot reach its own
# directory (denied on the bench, 26.10.2026: the gateway had never been
# started in this domain before).
gen_require(`
	type tactiq_agent_conf_t;
')
allow agentgateway_t tactiq_agent_conf_t:dir search;
allow agentgateway_t agentgateway_conf_t:dir list_dir_perms;
allow agentgateway_t agentgateway_conf_t:file read_file_perms;
# With --file the gateway always puts an inotify watch on the directory of
# its config (state_manager.rs, watch_config_file: the parent, not the file)
# and exits if it cannot. Denied on the bench (26.10.2026, 15 restarts, every
# one "Failed to watch config file: Permission denied"). The directory is on
# the dm-verity root, so the watch never fires; it only lets the gateway start.
allow agentgateway_t agentgateway_conf_t:dir watch;

# --- Name resolution: refused, and not logged ---
# At start the gateway's resolver reads /etc/hosts (net_conf_t) and looks
# into /run/systemd/resolve for resolv.conf. Both are denied on the bench,
# and the gateway starts without them: its targets are addresses. They stay
# denied (no DNS, see the absent list above); dontaudit keeps them out of the
# audit log, where a zero count of denials is how a clean boot is checked.
gen_require(`
	type net_conf_t, systemd_resolved_runtime_t;
')
dontaudit agentgateway_t net_conf_t:file read_file_perms;
dontaudit agentgateway_t systemd_resolved_runtime_t:dir search_dir_perms;

# --- Logs (append-only) ---
# The rules below assume the directory exists. Under ProtectSystem=strict
# the unit cannot create it in /var/log itself, so agentgateway.service
# must carry LogsDirectory=agentgateway. That unit lives in the tactiq-os
# tree and does not carry it yet -- until it does, the log path is
# unreachable at runtime and only the syslog route works.
allow agentgateway_t agentgateway_log_t:dir { search add_name };
allow agentgateway_t agentgateway_log_t:file { create open append getattr };
logging_log_filetrans(agentgateway_t, agentgateway_log_t, file)

# --- Syslog ---
logging_send_syslog_msg(agentgateway_t)

# --- Minimal system reads ---
files_read_etc_files(agentgateway_t)
miscfiles_read_localization(agentgateway_t)

# --- Deny everything else ---
# Implicit: all other access is denied by SELinux default-deny.
# No TPM (.service: PrivateDevices), no certs (plaintext loopback),
# no vault/data dirs, no runtime state dir in v1 (stateless empty perimeter).
