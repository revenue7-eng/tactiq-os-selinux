policy_module(tactiq_edge_daemon, 1.0.2)

########################################
# Type declarations
########################################
type tactiq_edge_daemon_t;
type tactiq_edge_daemon_exec_t;
# Model + fixtures the daemon reads (read-only).
type tactiq_edge_model_t;
files_type(tactiq_edge_model_t)
# The AF_UNIX listening socket node under /run/tactiq.
type tactiq_edge_runtime_t;
# Cartridges delivered to the data partition (/data/cartridges). Outside
# tactiq_vault_data_t on purpose: that type is appraised by IMA against the
# .ima keyring, which also verifies executables, so a cartridge key there
# would validate code. A cartridge carries its own signature, checked by the
# daemon; IMA measures reads of this type into PCR 11 and never appraises it.
# No domain is granted execute on it here.
type tactiq_cartridge_t;
files_type(tactiq_cartridge_t)

# Transition: systemd starts the binary -> runs as tactiq_edge_daemon_t
init_daemon_domain(tactiq_edge_daemon_t, tactiq_edge_daemon_exec_t)


# Runtime dir/socket node lives under /run (a tmpfs pid dir type).
files_runtime_file(tactiq_edge_runtime_t)

########################################
# Permissions
########################################

# --- Self ---
allow tactiq_edge_daemon_t self:process { signal_perms setrlimit getsched };
allow tactiq_edge_daemon_t self:fifo_file rw_fifo_file_perms;
# AF_UNIX server socket: create + bind + listen + accept. NO connect.
# This is the inbound-only inference socket. Inverted vs a client domain:
# the daemon never initiates a connection.
allow tactiq_edge_daemon_t self:unix_stream_socket { create_stream_socket_perms listen accept };

# --- Listening socket node in /run/tactiq (bind + manage the node) ---
allow tactiq_edge_daemon_t tactiq_edge_runtime_t:dir { search add_name remove_name write };
allow tactiq_edge_daemon_t tactiq_edge_runtime_t:sock_file { create setattr unlink };
# The socket node is created with the runtime type via filetrans.
files_runtime_filetrans(tactiq_edge_daemon_t, tactiq_edge_runtime_t, sock_file)
#
# Deliberately ABSENT (egress denied by default-deny):
#   corenet_tcp_connect_*   -- no TCP at all (AF_UNIX only, per wire proto v0)
#   corenet_*_bind          -- no network sockets; the perimeter has no listener
#   sysnet_dns_name_resolve -- no DNS
# The auth boundary IS this domain confinement (wire proto v0, section 1).

# --- Model + fixtures (read-only) ---
allow tactiq_edge_daemon_t tactiq_edge_model_t:dir list_dir_perms;
allow tactiq_edge_daemon_t tactiq_edge_model_t:file mmap_read_file_perms;

# --- Cartridges (read-only) ---
# The daemon reads the file, checks its signature against its anchor list and
# loads the verified bytes from memory: read, never mmap or execute.
gen_require(`
    type tactiq_data_fs_t;
    type tactiq_vault_data_t;
')
allow tactiq_cartridge_t tactiq_data_fs_t:filesystem associate;
# /data itself is vault-labelled; traverse it, read nothing there.
allow tactiq_edge_daemon_t tactiq_vault_data_t:dir search_dir_perms;
allow tactiq_edge_daemon_t tactiq_cartridge_t:dir list_dir_perms;
allow tactiq_edge_daemon_t tactiq_cartridge_t:file read_file_perms;

# --- Syslog (operator log: class verdicts) ---
logging_send_syslog_msg(tactiq_edge_daemon_t)

# --- Minimal system reads ---
files_read_etc_files(tactiq_edge_daemon_t)
miscfiles_read_localization(tactiq_edge_daemon_t)

# --- Deny everything else ---
# Implicit: all other access denied by SELinux default-deny.
# No other data/vault access, no devices, no outbound anything.

########################################
########################################
