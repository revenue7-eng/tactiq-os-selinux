# Configuration (system.conf, keyring certificate)
/etc/rauc(/.*)?				gen_context(system_u:object_r:tactiq_rauc_conf_t,s0)
/etc/tactiq/rauc(/.*)?			gen_context(system_u:object_r:tactiq_rauc_conf_t,s0)

# RAUC wrapper
/opt/tactiq/bin/tactiq-rauc		--	gen_context(system_u:object_r:tactiq_rauc_exec_t,s0)

# Runtime mount tree (RuntimeDirectory=rauc/mnt)
/run/rauc(/.*)?				gen_context(system_u:object_r:tactiq_rauc_runtime_t,s0)

# Bootloader environment tools (libubootenv; bootloader=uboot)
/usr/bin/fw_printenv			gen_context(system_u:object_r:tactiq_ubootenv_exec_t,s0)
/usr/bin/fw_setenv			gen_context(system_u:object_r:tactiq_ubootenv_exec_t,s0)
# RAUC binary (system RAUC)
/usr/bin/rauc			--	gen_context(system_u:object_r:tactiq_rauc_exec_t,s0)
/usr/sbin/fw_printenv			gen_context(system_u:object_r:tactiq_ubootenv_exec_t,s0)
/usr/sbin/fw_setenv			gen_context(system_u:object_r:tactiq_ubootenv_exec_t,s0)

# Generated bootloader environment config (RuntimeDirectory=tactiq-ubootenv)
/run/tactiq-ubootenv(/.*)?		gen_context(system_u:object_r:tactiq_ubootenv_runtime_t,s0)

# Runtime state (slot status, boot counter)
/var/lib/tactiq/rauc(/.*)?		gen_context(system_u:object_r:tactiq_rauc_var_t,s0)
# Bundle staging area (subdirectory of rauc var)
/var/lib/tactiq/rauc/bundles(/.*)?	gen_context(system_u:object_r:tactiq_rauc_bundle_t,s0)

# Logs
/var/log/tactiq/rauc(/.*)?		gen_context(system_u:object_r:tactiq_rauc_log_t,s0)
