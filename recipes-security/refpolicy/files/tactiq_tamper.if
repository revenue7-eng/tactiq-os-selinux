## <summary>TactiQ Tamper detection interfaces</summary>

########################################
## <summary>
##   Read tamper state (current sensor values, tamper events).
## </summary>
## <param name="domain">
##   <summary>Domain to grant read access.</summary>
## </param>
#
interface(`tactiq_tamper_read_state',`
    gen_require(`
        type tactiq_tamper_var_t;
    ')

    allow $1 tactiq_tamper_var_t:dir list_dir_perms;
    allow $1 tactiq_tamper_var_t:file read_file_perms;
')

########################################
## <summary>
##   Connect to tamper daemon via Unix socket.
## </summary>
## <param name="domain">
##   <summary>Domain to connect.</summary>
## </param>
#
interface(`tactiq_tamper_stream_connect',`
    gen_require(`
        type tactiq_tamper_t;
        type tactiq_tamper_var_t;
    ')

    stream_connect_pattern($1, tactiq_tamper_var_t, tactiq_tamper_var_t, tactiq_tamper_t)
')

########################################
## <summary>
##   Read tamper logs (audit trail).
## </summary>
## <param name="domain">
##   <summary>Domain to grant log read access.</summary>
## </param>
#
interface(`tactiq_tamper_read_log',`
    gen_require(`
        type tactiq_tamper_log_t;
    ')

    allow $1 tactiq_tamper_log_t:dir list_dir_perms;
    allow $1 tactiq_tamper_log_t:file read_file_perms;
')
