## <summary>tactiq-stop, the agent stop service</summary>

########################################
## <summary>
##   Allow a domain to ask tactiq-stop over TCP loopback (port 49318).
## </summary>
## <param name="domain">
##   <summary>Domain to grant access.</summary>
## </param>
#
# A wrapper over the corenet_ interface generated by network_port() for
# tactiq_stop_port_t, so callers name the service rather than the port.
#
interface(`tactiq_stop_tcp_connect',`
    corenet_tcp_connect_tactiq_stop_port($1)
')
