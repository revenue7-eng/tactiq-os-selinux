/etc/tactiq(/.*)?			gen_context(system_u:object_r:tactiq_agent_conf_t,s0)
/etc/tactiq/certs(/.*)?			gen_context(system_u:object_r:tactiq_agent_cert_t,s0)

/opt/tactiq/bin/tactiq-agent		--	gen_context(system_u:object_r:tactiq_agent_exec_t,s0)

# Created by systemd's RuntimeDirectory=tactiq-agent. The agent and the
# tpm2-tools it execs write transient TPM output here; the earlier entry
# labelled a control socket that the agent no longer opens.
/run/tactiq-agent(/.*)?			gen_context(system_u:object_r:tactiq_agent_runtime_t,s0)

/var/lib/tactiq/agent(/.*)?		gen_context(system_u:object_r:tactiq_agent_var_t,s0)

/var/log/tactiq/agent(/.*)?		gen_context(system_u:object_r:tactiq_agent_log_t,s0)

# Device state and envelopes on the data partition. More specific than the
# /data(/.*)? entry in tactiq_vault.fc, so these win the match.
/data/tactiq/keys(/.*)?		gen_context(system_u:object_r:tactiq_agent_state_t,s0)
/data/tactiq/counter(/.*)?	gen_context(system_u:object_r:tactiq_agent_state_t,s0)
/data/tactiq/audit(/.*)?	gen_context(system_u:object_r:tactiq_agent_audit_t,s0)
