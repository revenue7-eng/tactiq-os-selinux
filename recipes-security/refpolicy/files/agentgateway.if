## <summary>agentgateway MCP mediator policy interfaces</summary>

########################################
## <summary>
##   Allow a domain to connect to agentgateway over TCP loopback
##   (MCP listener, port 49317).
## </summary>
## <param name="domain">
##   <summary>Domain to grant access.</summary>
## </param>
#
# Note: since agentgateway_port_t is declared by network_port() in
# corenetwork.te.in, corenet_tcp_connect_agentgateway_port() is generated
# there and does the same thing. This wrapper is kept so callers do not
# have to change; prefer the corenet_ form in new policy.
#
interface(`agentgateway_tcp_connect',`
    gen_require(`
        type agentgateway_port_t;
    ')
    allow $1 agentgateway_port_t:tcp_socket name_connect;
')

########################################
## <summary>
##   Allow a domain to read agentgateway logs.
## </summary>
## <param name="domain">
##   <summary>Domain to grant access.</summary>
## </param>
interface(`agentgateway_read_log',`
    gen_require(`
        type agentgateway_log_t;
    ')
    allow $1 agentgateway_log_t:dir list_dir_perms;
    allow $1 agentgateway_log_t:file read_file_perms;
')
