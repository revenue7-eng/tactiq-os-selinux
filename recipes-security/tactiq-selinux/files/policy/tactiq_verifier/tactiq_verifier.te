policy_module(tactiq_verifier, 2.0.0)

########################################
# Type declarations
########################################

type tactiq_verifier_t;
type tactiq_verifier_exec_t;
type tactiq_verifier_conf_t;
type tactiq_verifier_log_t;
type tactiq_verifier_var_t;
type tactiq_verifier_cert_t;
type tactiq_verifier_port_t;
type tactiq_verifier_crl_t;

# Transition: systemd → tactiq_verifier_t
init_daemon_domain(tactiq_verifier_t, tactiq_verifier_exec_t)

# Custom port type for 8443
corenet_port(tactiq_verifier_port_t)

########################################
# Permissions
########################################

# --- Self ---
allow tactiq_verifier_t self:process { signal_perms setrlimit };
allow tactiq_verifier_t self:fifo_file rw_fifo_file_perms;
allow tactiq_verifier_t self:unix_stream_socket create_stream_socket_perms;
allow tactiq_verifier_t self:tcp_socket create_stream_socket_perms;

# --- Network: Listen on port 8443 (mTLS attestation) ---
allow tactiq_verifier_t tactiq_verifier_port_t:tcp_socket { name_bind };
allow tactiq_verifier_t self:tcp_socket { listen accept };
corenet_tcp_bind_generic_node(tactiq_verifier_t)

# --- Network: Connect to PostgreSQL (port 5432) for attestation DB ---
corenet_tcp_connect_postgresql_port(tactiq_verifier_t)

# --- Network: Connect to SIEM syslog (port 514/6514) ---
corenet_tcp_connect_syslogd_port(tactiq_verifier_t)

# --- DNS resolution ---
sysnet_dns_name_resolve(tactiq_verifier_t)

# --- Configuration (read-only) ---
allow tactiq_verifier_t tactiq_verifier_conf_t:dir list_dir_perms;
allow tactiq_verifier_t tactiq_verifier_conf_t:file read_file_perms;

# --- Certificates (read-only) ---
allow tactiq_verifier_t tactiq_verifier_cert_t:dir list_dir_perms;
allow tactiq_verifier_t tactiq_verifier_cert_t:file read_file_perms;

# --- CRL publish directory (write) ---
allow tactiq_verifier_t tactiq_verifier_crl_t:dir { search add_name write };
allow tactiq_verifier_t tactiq_verifier_crl_t:file { create open write getattr rename unlink };

# --- Logs (append-only) ---
allow tactiq_verifier_t tactiq_verifier_log_t:dir { search add_name };
allow tactiq_verifier_t tactiq_verifier_log_t:file { create open append getattr };
logging_log_filetrans(tactiq_verifier_t, tactiq_verifier_log_t, file)

# --- Runtime state + database cache ---
allow tactiq_verifier_t tactiq_verifier_var_t:dir manage_dir_perms;
allow tactiq_verifier_t tactiq_verifier_var_t:file manage_file_perms;
files_var_lib_filetrans(tactiq_verifier_t, tactiq_verifier_var_t, { dir file })

# --- Syslog ---
logging_send_syslog_msg(tactiq_verifier_t)

# --- System state for attestation verification ---
auth_read_passwd(tactiq_verifier_t)
miscfiles_read_localization(tactiq_verifier_t)
kernel_read_system_state(tactiq_verifier_t)
dev_read_realtime_clock(tactiq_verifier_t)
dev_read_urand(tactiq_verifier_t)
