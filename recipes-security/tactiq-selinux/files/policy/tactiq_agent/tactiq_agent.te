policy_module(tactiq_agent, 2.0.0)

########################################
# Type declarations
########################################

type tactiq_agent_t;
type tactiq_agent_exec_t;
type tactiq_agent_conf_t;
type tactiq_agent_log_t;
type tactiq_agent_var_t;
type tactiq_agent_tmp_t;
type tactiq_agent_cert_t;

# Transition: systemd starts binary → runs as tactiq_agent_t
init_daemon_domain(tactiq_agent_t, tactiq_agent_exec_t)

########################################
# Permissions
########################################

# --- Self ---
allow tactiq_agent_t self:process { signal_perms setrlimit };
allow tactiq_agent_t self:fifo_file rw_fifo_file_perms;
allow tactiq_agent_t self:unix_stream_socket create_stream_socket_perms;
allow tactiq_agent_t self:tcp_socket create_stream_socket_perms;

# --- Configuration (read-only) ---
allow tactiq_agent_t tactiq_agent_conf_t:dir list_dir_perms;
allow tactiq_agent_t tactiq_agent_conf_t:file read_file_perms;

# --- Logs (append-only) ---
allow tactiq_agent_t tactiq_agent_log_t:dir { search add_name };
allow tactiq_agent_t tactiq_agent_log_t:file { create open append getattr };
logging_log_filetrans(tactiq_agent_t, tactiq_agent_log_t, file)

# --- Runtime state ---
allow tactiq_agent_t tactiq_agent_var_t:dir manage_dir_perms;
allow tactiq_agent_t tactiq_agent_var_t:file manage_file_perms;
files_var_lib_filetrans(tactiq_agent_t, tactiq_agent_var_t, { dir file })

# --- Temp files ---
allow tactiq_agent_t tactiq_agent_tmp_t:file manage_file_perms;
files_tmp_filetrans(tactiq_agent_t, tactiq_agent_tmp_t, file)

# --- Certificates (read-only) ---
allow tactiq_agent_t tactiq_agent_cert_t:dir list_dir_perms;
allow tactiq_agent_t tactiq_agent_cert_t:file read_file_perms;

# --- TPM access (via /dev/tpm0 and /dev/tpmrm0) ---
# Calls tactiq_tpm interface
tactiq_tpm_access(tactiq_agent_t)

# --- Network: mTLS to verifier (port 8443 outbound only) ---
corenet_tcp_connect_generic_port(tactiq_agent_t)
sysnet_dns_name_resolve(tactiq_agent_t)

# --- Syslog ---
logging_send_syslog_msg(tactiq_agent_t)

# --- Read system clock (for attestation timestamps) ---
auth_read_passwd(tactiq_agent_t)
miscfiles_read_localization(tactiq_agent_t)
kernel_read_system_state(tactiq_agent_t)
dev_read_realtime_clock(tactiq_agent_t)

# --- GPIO access for tamper sensors (delegate to tactiq_tamper) ---
# agent does NOT directly access GPIO — it reads tamper state via IPC

# --- Deny everything else ---
# Implicit: all other access is denied by SELinux default-deny
