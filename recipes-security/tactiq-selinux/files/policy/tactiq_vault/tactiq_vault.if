## <summary>TactiQ Vault interfaces</summary>

########################################
## <summary>
##   Read/write data in the vault mount point.
## </summary>
## <param name="domain">
##   <summary>Domain to grant vault data access.</summary>
## </param>
#
interface(`tactiq_vault_data_rw',`
    gen_require(`
        type tactiq_vault_data_t;
    ')

    allow $1 tactiq_vault_data_t:dir manage_dir_perms;
    allow $1 tactiq_vault_data_t:file manage_file_perms;
')

########################################
## <summary>
##   Read-only access to vault data.
## </summary>
## <param name="domain">
##   <summary>Domain to grant read access.</summary>
## </param>
#
interface(`tactiq_vault_data_read',`
    gen_require(`
        type tactiq_vault_data_t;
    ')

    allow $1 tactiq_vault_data_t:dir list_dir_perms;
    allow $1 tactiq_vault_data_t:file read_file_perms;
')

########################################
## <summary>
##   Connect to vault daemon via Unix socket.
## </summary>
## <param name="domain">
##   <summary>Domain to connect.</summary>
## </param>
#
interface(`tactiq_vault_stream_connect',`
    gen_require(`
        type tactiq_vault_t;
        type tactiq_vault_var_t;
    ')

    stream_connect_pattern($1, tactiq_vault_var_t, tactiq_vault_var_t, tactiq_vault_t)
')
